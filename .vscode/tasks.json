{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite:dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "http://localhost:1420"
        }
      }
    },
    {
      "label": "cargo:build-debug",
      "type": "shell",
      "command": "cargo build",
      "options": {
        "cwd": "${workspaceFolder}/src-tauri",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "tauri:prelaunch",
      "type": "shell",
      "command": "${workspaceFolder}\\.vscode\\tauri-prelaunch.cmd",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "isBackground": true,
      "presentation": {
        "closeOnExit": true
      },
      "problemMatcher": {
        "owner": "tauri",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "http://localhost:1420"
        }
      },
      "detail": "调试前置任务：编译 Rust 调试版并启动 vite；内置监视脚本，调试停止/程序关闭后自动清理 vite"
    },
    {
      "label": "tauri:dev",
      "type": "shell",
      "command": "npm run tauri dev",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "tauri",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "http://localhost:1420"
        }
      },
      "detail": "完整启动应用（vite + 编译 + 拉起窗口），配合 Ctrl+F5/终端使用"
    }
  ]
}